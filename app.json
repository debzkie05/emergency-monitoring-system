{
  "expo": {
    "name": "CampusSafe",
    "slug": "campussafe",
    "scheme": "campussafe",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.campussafe.app"
    },
    "android": {
      "package": "com.campussafe.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true,
            "default": "development"
          }
        }
      ],
      "expo-image-picker",
      "expo-asset"
    ]
  }
}